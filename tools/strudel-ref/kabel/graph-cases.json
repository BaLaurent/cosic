  "code": "let f = n(220); const modu = sine(f).mul(.1).add(1.5); saw(f.mul(modu)).out()"
 },
 {
  "id": "redeclare-scope-const",
  "code": "let f = n(220); const mod = sine(f).mul(.1).add(1.5); saw(f.mul(mod)).out()",
  "note": "top-level let/const of a name that is an evaluate scope parameter (here lib `mod`) is a SyntaxError: the program is a function body whose parameters are the scope keys"
 },
 {
  "id": "redeclare-scope-var",
  "code": "var mod = sine(220); mod.out()",
  "note": "var may redeclare a parameter"
 },
 {
  "id": "redeclare-scope-let-n",
  "code": "let n = 3; sine(n).out()"
 },
 {
  "id": "redeclare-scope-inner",
  "code": "(() => { const mod = sine(2); sine(220).mul(mod).out() })()",
  "note": "inside a function the same name is fine (ex1 template relies on this)"
 },
 {
  "id": "redeclare-scope-assign",
  "code": "sine = 5; saw(220).out()",
  "note": "assigning to a scope parameter is allowed (sloppy function)"
 },
 {
  "id": "lib-registerUgen",
  "code": "typeof registerUgen === \"function\" ? sine(220).out() : saw(220).out()"
 }
]
