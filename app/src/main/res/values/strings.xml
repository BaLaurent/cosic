    <string name="reference_doc_synth">A synth waveform. Give it pitch with note().</string>
    <string name="reference_doc_drum">A drum sound. Pick a variant with a number, as in bd:2.</string>
    <string name="reference_doc_instrument">A sampled instrument. Play it with note(); each note uses the nearest recorded one.</string>
    <string name="reference_doc_percussion">A set of recorded percussion hits. Pick one with a number, as in cowbell:3.</string>
    <string name="reference_doc_wavetable">A wavetable synth: each file holds waves that make the tone. Give it pitch with note(), and pick a file with a number, as in wt_digital:2.</string>
    <string name="reference_doc_imported">A sound you added: a folder you imported, or samples() in your code. Pick a sample with a number, as in mine:1.</string>
    <string name="reference_scales">Scales</string>
    <string name="reference_doc_scale">A scale for scale(): put a root note before it, as in C:minor or eb2:dorian.</string>
