// Hardbass
// 155 BPM. A kick on every beat, a
// clap on 2 and 4, and a distorted
// bass that bounces on the off-beats:
// "oom, PAH, oom, PAH". A harsh synth
// riff in A minor plays over Am | F |
// G | Am, and everything is pushed
// hard into distortion.
setcpm(155 / 4)

// The kick ducks the bass, so the two
// never fight for the low end
$: s("bd*4")
  .bank("cosic909")
  .gain(0.4)
  .distort(0.4)
  .duckorbit(2)
  .duckattack(0.15)
  .duckdepth(0.9)
$: s("~ cp ~ cp").bank("cosic909").gain(0.4)
$: s("[~ oh]*4").bank("cosic909").gain(0.22)
$: s("hh*16")
  .bank("cosic909")
  .gain("[0.13 0.07]*8")
  .mask("<0 0 1 1 1 1 1 1>")

// The bass: root notes on the off-
// beats only
$: note("<a2 f2 g2 a2>")
  .struct("~ x ~ x ~ x ~ x")
  .s("sawtooth")
  .lpf(700)
  .distort(0.6)
  .decay(0.14)
  .sustain(0)
  .orbit(2)
  .gain(0.6)

// The hook: the same shape on each
// chord (root, third, fifth), the
// last bar ends on b4
$: note(`<[a4 ~ a4 c5 ~ e5 ~ c5]
          [f4 ~ f4 a4 ~ c5 ~ a4]
          [g4 ~ g4 b4 ~ d5 ~ b4]
          [a4 ~ a4 c5 ~ e5 [d5 c5] b4]>`)
  .s("supersaw")
  .lpf(4000)
  .distort(0.4)
  .decay(0.18)
  .sustain(0.4)
  .gain(0.55)
  .mask("<0 0 1 1 1 1 1 1>")
