// Chiptune
// 150 BPM. Old game consoles had very
// few voices, so every voice has one
// job: a pulse wave for the lead, a
// thinner pulse wave that arpeggiates
// the chord, a triangle wave for the
// bass, and noise for the drums. Am |
// F | C | G.
setcpm(150 / 4)

// Lead: the first notes of each bar
// spell the chord (root, third,
// fifth, octave)
$: note(`<[a4 [c5 e5] a5 ~ e5 [d5 c5] a4 ~]
          [f4 [a4 c5] f5 ~ c5 [g4 a4] f4 ~]
          [c5 [e5 g5] c6 ~ g5 [f5 e5] c5 ~]
          [g4 [b4 d5] g5 ~ d5 [e5 d5] b4 ~]>`)
  .s("pulse")
  .pw(0.5)
  .decay(0.15)
  .sustain(0.5)
  .gain(0.75)

// Arpeggio: one voice plays the chord
// notes one after another, 16 per
// cycle. The ear hears a chord
// although only one note sounds at a
// time.
$: note(`<[a3 c4 e4 c4]*4
          [a3 c4 f4 c4]*4
          [g3 c4 e4 c4]*4
          [g3 b3 d4 b3]*4>`)
  .s("pulse")
  .pw(0.25)
  .decay(0.08)
  .sustain(0)
  .gain(0.6)

// Bass: triangle waves have no volume
// control, so it is always at full
// volume
$: note(`<[a2 a2 e3 a2]*2
          [f2 f2 c3 f2]*2
          [c3 c3 g3 c3]*2
          [g2 g2 d3 g2]*2>`)
  .s("triangle")
  .gain(0.8)

// Drums are noise: a quick burst is a
// hat, a longer one a snare. The kick
// is a low tone that falls in pitch.
$: note("a1")
  .s("sine")
  .struct("x ~ ~ ~ ~ ~ ~ ~ x ~ x ~ ~ ~ ~ ~")
  .penv(24)
  .pdecay(0.05)
  .decay(0.12)
  .sustain(0)
  .gain(1.3)
$: s("white")
  .struct("~ ~ ~ ~ x ~ ~ ~ ~ ~ ~ ~ x ~ ~ ~")
  .hpf(1500)
  .decay(0.12)
  .sustain(0)
  .gain(0.55)
$: s("white")
  .struct("x*8")
  .hpf(8000)
  .decay(0.03)
  .sustain(0)
  .gain(0.3)
