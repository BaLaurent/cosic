// Techno
// 132 BPM, hypnotic. The whole track
// sits on one chord (A minor) and
// lives in what comes and goes: a
// hard kick, a rolling bass riff and
// a filter that slowly opens and
// closes. The layers join one after
// another.
setcpm(132 / 4)

$: s("bd*4")
  .bank("cosic909")
  .gain(0.58)
  .duckorbit(2)
  .duckattack(0.15)
  .duckdepth(0.7)
$: s("~ cp ~ cp")
  .bank("cosic909")
  .gain(0.33)
  .mask("<0 0 1 1 1 1 1 1>")
$: s("[~ oh]*4")
  .bank("cosic909")
  .gain(0.2)
  .mask("<0 1 1 1 1 1 1 1>")
$: s("hh*16")
  .bank("cosic909")
  .gain("[0.1 0.05 0.08 0.05]*4")
  .mask("<0 0 0 1 1 1 1 1>")

// An uneven pattern: 5 hits spread
// over 16 steps (euclidean rhythm)
$: s("rim(5,16)")
  .bank("cosic909")
  .gain(0.28)
  .mask("<0 0 0 0 1 1 1 1>")

// The riff: 16th notes on A with a
// few jumps. The filter sweeps over 4
// cycles.
$: note(`a1 a1 a2 a1
         a1 a1 c2 a1
         a1 a2 a1 a1
         e2 a1 g1 a1`)
  .s("sawtooth")
  .lpf(sine.range(250, 1800).slow(4))
  // resonance makes the sweep audible
  .lpq(12)
  .decay(0.12)
  .sustain(0.1)
  .orbit(2)
  .gain(0.45)
  .mask("<0 0 1 1 1 1 1 1>")

// A dub chord with long echoes, only
// in the second half
$: note("[a3,c4,e4]")
  .struct("x ~ ~ ~ ~ ~ x ~")
  .s("triangle")
  .decay(0.25)
  .sustain(0)
  .delay(0.6)
  .delayfeedback(0.6)
  .room(0.5)
  .gain(0.33)
  .mask("<0 0 0 0 1 1 1 1>")
