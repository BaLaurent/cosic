// Lo-fi hip-hop
// About 80 BPM. A lazy boom-bap beat
// under warm jazz chords, with a few
// sparse notes and vinyl crackle. The
// groove sits "behind" the beat: the
// kick and the hats are nudged late,
// the snare early, so it feels loose
// and human.
setcpm(80 / 4)

// Fmaj7 | Em7 | Dm7 | G7 in C major,
// one chord per cycle
$: note(`<[f3,a3,c4,e4]
          [e3,g3,b3,d4]
          [d3,f3,a3,c4]
          [g3,b3,d4,f4]>`)
  .s("triangle")
  .lpf(1400)
  .attack(0.02)
  .release(0.6)
  // a little bit crushing makes it
  // sound old
  .crush(10)
  .room(0.4)
  .gain(0.25)

// The bass plays the root, locked to
// the kick
$: note("<f2 e2 d2 g2>")
  .s("sine")
  .struct("x ~ ~ ~ x x ~ ~")
  .release(0.1)
  .gain(0.6)

// Boom-bap: kick on 1, 3 and the
// "and" of 3, snare on 2 and 4. late
// and early move the hits by a
// fraction of a cycle. The last cycle
// of every eight has no drums:
// variation by subtraction.
$: s("bd ~ ~ ~ bd bd ~ ~")
  .late(0.01)
  .gain(0.5)
  .mask("<1 1 1 1 1 1 1 0>")
$: s("~ ~ sd ~ ~ ~ sd ~")
  .early(0.01)
  .lpf(4000)
  .gain(0.5)
  .mask("<1 1 1 1 1 1 1 0>")
$: s("hh*8")
  .gain("[0.5 0.25]*4")
  .late("[0 0.012]*4")
  .lpf(7000)
  .mask("<1 1 1 1 1 1 1 0>")

// Four notes of C major pentatonic,
// every other cycle, with a long echo
$: note(`<[~ e5 ~ g5 ~ ~ a5 ~]
          ~
          [~ ~ g5 ~ e5 ~ ~ ~]
          ~>`)
  .s("triangle")
  .delay(0.4)
  .delayfeedback(0.4)
  .room(0.5)
  .gain(0.6)

// Vinyl crackle
$: s("crackle")
  .density(0.05)
  .hpf(500)
  .gain(0.5)
